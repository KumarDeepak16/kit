{
  "manifest_version": 3,
  "name": "Kit",
  "short_name": "Kit",
  "description": "Local-first toolkit: per-tab volume boost, encrypted password vault and Wi-Fi drop between your devices.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "homepage_url": "https://kit.1619.in",
  "key": "",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Kit",
    "default_icon": {
      "16": "icons/off/16.png",
      "32": "icons/off/32.png",
      "48": "icons/off/48.png",
      "128": "icons/off/128.png"
    }
  },
  "icons": {
    "16": "icons/on/16.png",
    "32": "icons/on/32.png",
    "48": "icons/on/48.png",
    "128": "icons/on/128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "storage",
    "alarms",
    "idle",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; connect-src http://127.0.0.1:*"
  }
}
